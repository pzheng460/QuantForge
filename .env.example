# QuantForge Application Environment Configuration Example
# Copy this file to .env and modify the values as needed.

# redis settings
# The job registry (completed backtest/optimize jobs) defaults to a JSON file
# under ~/.quantforge/jobs/. Set QUANTFORGE_REDIS_HOST (or QUANTFORGE_REDIS_URL)
# and install the `redis` package to persist the registry in Redis instead.
# `docker compose up redis` provisions the server for this.
QUANTFORGE_REDIS_HOST=127.0.0.1
QUANTFORGE_REDIS_PORT=6379
QUANTFORGE_REDIS_DB=0
QUANTFORGE_REDIS_PASSWORD=your_redis_password

# PostgreSQL settings
# NOTE: postgres is provisioned in docker-compose.yml but currently has NO
# application consumer — nothing in QuantForge reads or writes it yet.
# The vars document the intended deployment rather than a live wiring.
QUANTFORGE_PG_HOST=localhost
QUANTFORGE_PG_PORT=5432
QUANTFORGE_PG_USER=postgres
QUANTFORGE_PG_PASSWORD=your_postgres_password
QUANTFORGE_PG_DB=postgres

# Dynaconf settings
REDIS_ENABLED_FOR_DYNACONF=true
REDIS_HOST_FOR_DYNACONF=localhost
REDIS_PORT_FOR_DYNACONF=6379
REDIS_PASSWORD_FOR_DYNACONF=your_redis_password
ENVVAR_PREFIX_FOR_DYNACONF=QUANTFORGE

# Optional: required only when the dashboard backend is exposed beyond
# 127.0.0.1 (start.sh --host 0.0.0.0). Every /api* request then needs the
# `X-API-Key` header (or `?api_key=` for WebSockets).
QUANTFORGE_API_KEY=