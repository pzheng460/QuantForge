//@version=5
strategy("EMA Crossover v3", overlay=true, initial_capital=100000, default_qty_type=strategy.percent_of_equity, default_qty_value=60)

// --- Inputs ---
fast_period = input.int(7, title="Fast EMA", minval=3, maxval=20, step=1)
slow_period = input.int(18, title="Slow EMA", minval=10, maxval=50, step=1)
adx_period = input.int(14, title="ADX Period")
adx_threshold = input.int(25, title="ADX Threshold", minval=10, maxval=40)
atr_period = input.int(14, title="ATR Period")
atr_mult = input.float(2.0, title="ATR Stop Multiplier", minval=0.5, maxval=5.0, step=0.1)

// --- Indicators ---
fast = ta.ema(close, fast_period)
slow = ta.ema(close, slow_period)
[di_plus, di_minus, adx_val] = ta.dmi(adx_period, adx_period)
atr_val = ta.atr(atr_period)
trending = adx_val > adx_threshold

// --- Entry: EMA crossover with ADX filter ---
if ta.crossover(fast, slow) and trending
    strategy.entry("Long", strategy.long)
if ta.crossunder(fast, slow) and trending
    strategy.entry("Short", strategy.short)

// --- ATR-based fixed stop-loss ---
if strategy.position_size > 0
    strategy.exit("Long SL", "Long", stop=strategy.position_avg_price - atr_mult * atr_val)
if strategy.position_size < 0
    strategy.exit("Short SL", "Short", stop=strategy.position_avg_price + atr_mult * atr_val)
