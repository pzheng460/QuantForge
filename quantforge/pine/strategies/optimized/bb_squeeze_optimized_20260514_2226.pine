//@version=5
strategy("BB Squeeze Breakout", overlay=true, initial_capital=100000)

// --- Inputs ---
bb_len = input.int(20, title="BB Length", minval=10, maxval=40, step=5)
bb_std = input.float(2.0, title="BB StdDev", minval=1.5, maxval=3.0, step=0.5)
ema_fast = input.int(8, title="Fast EMA", minval=5, maxval=15, step=1)
ema_slow = input.int(21, title="Slow EMA", minval=15, maxval=30, step=1)
atr_len = input.int(14, title="ATR Length", minval=7, maxval=21, step=1)
atr_mult = input.float(1.5, title="ATR Stop Mult", minval=0.5, maxval=3.0, step=0.1)

// --- Indicators ---
basis = ta.sma(close, bb_len)
dev = bb_std * ta.stdev(close, bb_len)
upper = basis + dev
lower = basis - dev
bb_width = (upper - lower) / basis
fast = ta.ema(close, ema_fast)
slow = ta.ema(close, ema_slow)
atr_val = ta.atr(atr_len)

// --- Squeeze detection: BB width contracting ---
avg_width = ta.sma(bb_width, bb_len)
squeeze = bb_width < avg_width

// --- Track entry price for stop loss ---
var float entry_price = na

// --- Breakout from squeeze ---
breakout = squeeze[1] and not squeeze

if breakout and fast > slow and strategy.position_size <= 0
    entry_price := close
    strategy.entry("Long", strategy.long)
if breakout and fast < slow and strategy.position_size >= 0
    entry_price := close
    strategy.entry("Short", strategy.short)

// --- ATR stop loss (priority) ---
if strategy.position_size > 0 and close < entry_price - atr_mult * atr_val
    strategy.close("Long")
if strategy.position_size < 0 and close > entry_price + atr_mult * atr_val
    strategy.close("Short")

// --- Take profit: opposite band touch (mean reversion of breakout) ---
if strategy.position_size > 0 and close > upper
    strategy.close("Long")
if strategy.position_size < 0 and close < lower
    strategy.close("Short")
