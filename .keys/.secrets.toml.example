[BINANCE.LIVE]
API_KEY = "your_api_key"
SECRET = "your_api_secret"

[SCHWAB]
CALLBACK_URL = "https://127.0.0.1:8000/api/brokers/schwab/auth/callback"

[SCHWAB.MARKET_DATA]
CLIENT_ID = "your_market_data_client_id"
CLIENT_SECRET = "your_market_data_client_secret"

[SCHWAB.TRADING]
CLIENT_ID = "your_accounts_and_trading_client_id"
CLIENT_SECRET = "your_accounts_and_trading_client_secret"

[SMTP]
HOST = "smtp.gmail.com"
PORT = 587
# Gmail 第二步验证需用"应用专用密码"（https://myaccount.google.com/apppasswords）
USERNAME = "your_sender@gmail.com"
PASSWORD = "your_app_specific_password"
FROM = "your_sender@gmail.com"
TO = "pzheng460@gmail.com"   # 逗号分隔支持多个收件人
